# Copy to .env.local (ignored); configure in Supabase Edge Function secrets.
ONESIGNAL_APP_ID=YOUR_ONESIGNAL_APP_UUID
ONESIGNAL_REST_API_KEY=YOUR_ONESIGNAL_APP_API_KEY
CHALLENGE_PUSH_SITE_URL=https://YOUR_EXACT_PRODUCTION_ORIGIN
CHALLENGE_PUSH_DISPATCH_SECRET=GENERATE_AT_LEAST_32_RANDOM_BYTES
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided by hosted Edge Functions.
